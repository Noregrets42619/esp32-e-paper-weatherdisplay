menu "Open-Meteo Weather Configuration"
config PLACE_NAME
    string "Display place name (Chinese subset / Latin)"
    default "成都市郫都区"
    help
        Chinese glyphs are compiled as a subset. For a custom place, add its
        characters to main/fonts/characters.txt and regenerate the font tables.

config LATITUDE
    string "WGS84 latitude"
    default "30.80993"
    help
        Default: Pitong, Pidu District, Chengdu. No API key is required.

config LONGITUDE
    string "WGS84 longitude"
    default "103.88253"

config WEATHER_TIMEZONE
    string "Open-Meteo IANA timezone"
    default "Asia/Shanghai"
    help
        Must match the local POSIX timezone in WT32-ETH01 Configuration.
endmenu
