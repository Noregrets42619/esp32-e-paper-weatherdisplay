# put here your custom config value
menu "WiFi Configuration"
config ESP_WIFI_SSID
    string "WiFi SSID"
    default "myssid"
    help
	SSID (network name) for the project to connect to.

config ESP_WIFI_PASSWORD
    string "WiFi Password"
    default "mypassword"
    help
	WiFi password (WPA or WPA2) for the project to use.

config ESP_DNS_NAME
    string "DNS Name"
    default "myweatherdisplay"
    help
	DNS name for the project to use in the network.


config OTA_URL
    string "OTA URL"
    default "http://192.168.178.176:8080/build/e-paper-weatherdisplay.bin"
    help
	URL for getting the bin file over the air using http.
endmenu
menu "WT32-ETH01 Configuration"
config EPD_DIAGNOSTIC_MODE
    bool "Screen-only diagnostic (no Wi-Fi, SPI 100 kHz)"
    default n
    help
        Initialize the 4.2-inch G panel and display four color bars once.
        Skip Wi-Fi, weather and ESP32 deep sleep. On failure, allow 60 seconds
        for voltage measurements, then hold panel reset LOW and stop.
        Disable this option to restore the weather display.

config ENABLE_OTA_BUTTON
    bool "Enable OTA button on GPIO39 (external 10k pull-up required)"
    default n
    help
        GPIO4 is now the e-paper CS pin. Connect an optional button between
        GPIO39 and GND, with a 10k resistor from GPIO39 to 3V3.
        GPIO39 is input-only and has no internal pull-up.

config DISPLAY_TIMEZONE
    string "POSIX timezone"
    default "CST-8"
    help
        CST-8 is UTC+8 (China). Uses POSIX rather than IANA timezone syntax.
endmenu
